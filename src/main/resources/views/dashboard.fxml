<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.nepe.match.adapter.in.DashboardController"
            styleClass="app-container"
            prefHeight="750.0" prefWidth="1180.0">

    <!-- Left Navigation Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220.0" spacing="10.0">
            <padding>
                <Insets top="20.0" right="12.0" bottom="20.0" left="12.0"/>
            </padding>

            <!-- App Title -->
            <VBox spacing="2.0">
                <Label text="NEPE" styleClass="app-title"/>
                <Label text="Nexus Exchange Prediction" styleClass="label-muted"/>
            </VBox>

            <Separator opacity="0.2"/>

            <!-- Navigation Buttons -->
            <Button fx:id="btnNavDashboard" text="📊 Palinsesto" styleClass="nav-button, nav-button-active" maxWidth="Infinity" onAction="#handleNavDashboard">
                <tooltip><Tooltip text="Visualizza il palinsesto partite"/></tooltip>
            </Button>
            <Button fx:id="btnNavPreMatch" text="🎯 Analisi Pre-Match" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavPreMatch">
                <tooltip><Tooltip text="Analisi quote, Dixon-Coles ed Expected Value"/></tooltip>
            </Button>
            <Button fx:id="btnNavLive" text="⚡ Console Live" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavLive">
                <tooltip><Tooltip text="Console di monitoraggio eventi e probabilità in tempo reale"/></tooltip>
            </Button>
            <Button fx:id="btnNavCompetition" text="🏆 Anagrafiche" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavCompetition">
                <tooltip><Tooltip text="Gestione campionati, squadre e alias"/></tooltip>
            </Button>
            <Button fx:id="btnNavSettings" text="⚙️ Impostazioni" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavSettings">
                <tooltip><Tooltip text="Configurazione parametri e preferenze globali"/></tooltip>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="lblDbStatus" text="🟢 MariaDB Connesso" styleClass="label-muted"/>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox styleClass="content-pane" spacing="14.0">
            <padding>
                <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
            </padding>

            <!-- Top Header & Filter Controls Container (2-Row Responsive Layout) -->
            <VBox spacing="10.0">
                <!-- Row 1: Competition & Season Selectors (Left) + Match State Filters (Right) -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Competizione:" styleClass="section-header"/>
                    <ComboBox fx:id="comboCompetition" prefWidth="190.0" promptText="Seleziona Campionato..."/>

                    <Label text="Stagione:" styleClass="section-header"/>
                    <ComboBox fx:id="comboSeason" prefWidth="130.0" promptText="Seleziona Stagione..."/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Match State Filter Buttons (Right-aligned) -->
                    <HBox spacing="6.0" alignment="CENTER_RIGHT">
                        <Button fx:id="btnFilterAll" text="Tutte" styleClass="button, btn-primary" onAction="#handleFilterAll">
                            <tooltip><Tooltip text="Mostra tutte le partite del palinsesto"/></tooltip>
                        </Button>
                        <Button fx:id="btnFilterScheduled" text="Programmate" styleClass="button" onAction="#handleFilterScheduled">
                            <tooltip><Tooltip text="Filtra solo partite programmate"/></tooltip>
                        </Button>
                        <Button fx:id="btnFilterLive" text="Live" styleClass="button" onAction="#handleFilterLive">
                            <tooltip><Tooltip text="Filtra solo partite in corso"/></tooltip>
                        </Button>
                        <Button fx:id="btnFilterFinished" text="Terminate" styleClass="button" onAction="#handleFilterFinished">
                            <tooltip><Tooltip text="Filtra solo partite concluse"/></tooltip>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Row 2: Summary Counter & Action Buttons -->
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label fx:id="lblSummary" text="Partite caricate: 0" styleClass="label-muted"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Primary Action Buttons -->
                    <Button fx:id="btnImportCsv" text="📂 Importa CSV" styleClass="button, btn-primary" onAction="#handleImportCsv">
                        <tooltip><Tooltip text="Carica file CSV da Football-Data"/></tooltip>
                    </Button>
                    <Button fx:id="btnAddMatch" text="➕ Aggiungi Match" styleClass="button" onAction="#handleAddMatch">
                        <tooltip><Tooltip text="Aggiungi una nuova partita manualmente"/></tooltip>
                    </Button>
                    <Button fx:id="btnRefresh" text="🔄 Aggiorna" styleClass="button" onAction="#handleRefresh">
                        <tooltip><Tooltip text="Ricarica i dati e ricalcola le probabilità"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <!-- Matches Table -->
            <VBox VBox.vgrow="ALWAYS" spacing="8.0">
                <TableView fx:id="tblMatches" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDateTime" text="Data / Ora (CET)" prefWidth="130.0"/>
                        <TableColumn fx:id="colHomeTeam" text="Squadra Casa" prefWidth="180.0"/>
                        <TableColumn fx:id="colAwayTeam" text="Squadra Ospite" prefWidth="180.0"/>
                        <TableColumn fx:id="colState" text="Stato" prefWidth="100.0"/>
                        <TableColumn fx:id="colScore" text="Risultato" prefWidth="80.0"/>
                        <TableColumn fx:id="colOdds" text="Quote 1X2 Riferimento" prefWidth="160.0"/>
                        <TableColumn fx:id="colEvBadge" text="Segnale EV+" prefWidth="160.0"/>
                        <TableColumn fx:id="colActions" text="Azioni" prefWidth="290.0"/>
                    </columns>
                    <placeholder>
                        <Label text="Nessuna partita disponibile per la competizione e i filtri selezionati." styleClass="label-muted"/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Bottom Status Footer -->
            <HBox spacing="16.0" alignment="CENTER_LEFT">
                <Label fx:id="lblMessage" text="" styleClass="label-muted"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
